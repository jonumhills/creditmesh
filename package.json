{
  "name": "creditmesh",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "contracts",
    "backend",
    "frontend",
    "agents",
    "mcp"
  ],
  "scripts": {
    "build": "npm run build --workspace=backend",
    "start": "node backend/dist/index.js",
    "contracts:compile": "npm run compile --workspace=contracts",
    "contracts:test": "npm run test --workspace=contracts",
    "contracts:deploy": "npm run deploy:sepolia --workspace=contracts",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend",
    "agents:lender":    "npm run lender --workspace=agents",
    "agents:borrower":  "npm run borrower --workspace=agents",
    "agents:test-swap": "npm run agents:test-swap --workspace=agents",
    "mcp:start": "npm run start --workspace=mcp",
    "mcp:dev": "npm run dev --workspace=mcp",
    "keeper:register": "npm run keeper:register --workspace=backend",
    "ens:setup":       "npm run ens:setup --workspace=backend",
    "ens:mint-all":    "npm run ens:mint-all --workspace=backend",
    "install:all": "npm install --workspaces"
  },
  "description": "CreditMesh — P2P credit market for AI agents on Ethereum Sepolia",
  "keywords": [
    "defi",
    "agents",
    "sepolia",
    "lending",
    "uniswap",
    "keeperhub",
    "ens",
    "usdc",
    "ethglobal"
  ]
}
